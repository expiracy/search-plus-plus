{
  "name": "search-plus-plus",
  "displayName": "search++",
  "description": "Unified popup search for files, folders, text, symbols, usages and commands. Inspired by JetBrains IDEs.",
  "version": "3.0.4",
  "private": true,
  "publisher": "expiracy",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/expiracy/search-plus-plus"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "search",
    "find",
    "file search",
    "text search",
    "symbol search",
    "fuzzy search",
    "regex",
    "go to file",
    "navigate",
    "jetbrains",
    "intellij",
    "search everywhere",
    "quick open",
    "ripgrep",
    "double shift",
    "finder",
    "grep",
    "file finder",
    "search in files",
    "find in files",
    "go to symbol",
    "file explorer",
    "workspace search",
    "content search",
    "code search",
    "filter",
    "lookup",
    "open file",
    "webstorm",
    "pycharm",
    "command palette",
    "command search",
    "actions"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "searchPlusPlus.open",
        "title": "search++: Open Search"
      },
      {
        "command": "searchPlusPlus.openFiles",
        "title": "search++: Search Files"
      },
      {
        "command": "searchPlusPlus.openText",
        "title": "search++: Search Text"
      },
      {
        "command": "searchPlusPlus.openSymbols",
        "title": "search++: Search Symbols"
      },
      {
        "command": "searchPlusPlus.openCommands",
        "title": "search++: Search Commands"
      },
      {
        "command": "searchPlusPlus.reindex",
        "title": "search++: Reindex Workspace"
      },
      {
        "command": "searchPlusPlus.toggleCaseSensitive",
        "title": "search++: Toggle Case Sensitive"
      },
      {
        "command": "searchPlusPlus.toggleRegex",
        "title": "search++: Toggle Regex"
      },
      {
        "command": "searchPlusPlus.toggleGitIgnore",
        "title": "search++: Toggle Only Git Trackable"
      },
      {
        "command": "searchPlusPlus.toggleSearchIgnore",
        "title": "search++: Toggle Exclude Search Ignored"
      },
      {
        "command": "searchPlusPlus.toggleFuzzySearch",
        "title": "search++: Toggle Fuzzy Search"
      },
      {
        "command": "searchPlusPlus.toggleMatchWholeWord",
        "title": "search++: Toggle Match Whole Word"
      },
      {
        "command": "searchPlusPlus.nextTab",
        "title": "search++: Next Tab"
      },
      {
        "command": "searchPlusPlus.prevTab",
        "title": "search++: Previous Tab"
      },
      {
        "command": "searchPlusPlus.autofillPath",
        "title": "search++: Autofill File Path"
      },
      {
        "command": "searchPlusPlus.findUsages",
        "title": "search++: Find Usages"
      },
      {
        "command": "searchPlusPlus.preview",
        "title": "search++: Preview Selected Result"
      },
      {
        "command": "searchPlusPlus.configure",
        "title": "search++: Open Settings"
      }
    ],
    "keybindings": [
      {
        "command": "searchPlusPlus.open",
        "key": "shift shift",
        "mac": "shift shift"
      },
      {
        "command": "searchPlusPlus.toggleCaseSensitive",
        "key": "alt+c",
        "when": "searchPlusPlusModalOpen"
      },
      {
        "command": "searchPlusPlus.toggleRegex",
        "key": "alt+r",
        "when": "searchPlusPlusModalOpen"
      },
      {
        "command": "searchPlusPlus.toggleGitIgnore",
        "key": "alt+g",
        "when": "searchPlusPlusModalOpen"
      },
      {
        "command": "searchPlusPlus.toggleSearchIgnore",
        "key": "alt+s",
        "when": "searchPlusPlusModalOpen"
      },
      {
        "command": "searchPlusPlus.toggleFuzzySearch",
        "key": "alt+f",
        "when": "searchPlusPlusModalOpen"
      },
      {
        "command": "searchPlusPlus.toggleMatchWholeWord",
        "key": "alt+w",
        "when": "searchPlusPlusModalOpen"
      },
      {
        "command": "searchPlusPlus.nextTab",
        "key": "tab",
        "when": "searchPlusPlusModalOpen"
      },
      {
        "command": "searchPlusPlus.autofillPath",
        "key": "ctrl+enter",
        "when": "searchPlusPlusModalOpen && searchPlusPlusFileTab"
      },
      {
        "command": "searchPlusPlus.findUsages",
        "key": "shift+f12",
        "when": "searchPlusPlusModalOpen"
      },
      {
        "command": "searchPlusPlus.findUsages",
        "key": "ctrl+enter",
        "when": "searchPlusPlusModalOpen && searchPlusPlusSymbolTab"
      },
      {
        "command": "searchPlusPlus.preview",
        "key": "ctrl+right",
        "mac": "cmd+right",
        "when": "searchPlusPlusModalOpen"
      },
      {
        "command": "searchPlusPlus.openFiles",
        "key": "ctrl+p",
        "mac": "cmd+p",
        "when": "config.searchPlusPlus.shortcutPreset == 'vscode'"
      },
      {
        "command": "searchPlusPlus.openSymbols",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "config.searchPlusPlus.shortcutPreset == 'vscode'"
      },
      {
        "command": "searchPlusPlus.openText",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "config.searchPlusPlus.shortcutPreset == 'vscode'"
      },
      {
        "command": "searchPlusPlus.openCommands",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "config.searchPlusPlus.shortcutPreset == 'vscode'"
      },
      {
        "command": "searchPlusPlus.openFiles",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+o",
        "when": "config.searchPlusPlus.shortcutPreset == 'intellij'"
      },
      {
        "command": "searchPlusPlus.openSymbols",
        "key": "ctrl+n",
        "mac": "cmd+o",
        "when": "config.searchPlusPlus.shortcutPreset == 'intellij'"
      },
      {
        "command": "searchPlusPlus.openText",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "config.searchPlusPlus.shortcutPreset == 'intellij'"
      },
      {
        "command": "searchPlusPlus.openCommands",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "config.searchPlusPlus.shortcutPreset == 'intellij'"
      }
    ],
    "configuration": [
      {
        "title": "Search window",
        "order": 1,
        "properties": {
          "searchPlusPlus.tabs": {
            "order": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Everything",
                "Files",
                "Folders",
                "Text",
                "Symbols",
                "Commands"
              ]
            },
            "uniqueItems": true,
            "minItems": 1,
            "default": [
              "Everything",
              "Files",
              "Folders",
              "Text",
              "Symbols",
              "Commands"
            ],
            "markdownDescription": "Tabs shown in the search window. **Drag rows to reorder.** Remove a tab to hide it; choose **Add Item** to show it again. Keep at least one tab. Direct search commands can still open hidden tabs."
          },
          "searchPlusPlus.defaultMode": {
            "order": 2,
            "type": "string",
            "enum": [
              "everywhere",
              "file",
              "folder",
              "text",
              "symbol",
              "command"
            ],
            "enumDescriptions": [
              "Everything tab",
              "Files tab",
              "Folders tab",
              "Text tab",
              "Symbols tab",
              "Commands tab"
            ],
            "default": "everywhere",
            "description": "Opening tab when Remember Last Mode is off. If hidden, the first visible tab opens. Direct search commands still open their requested tab.",
            "enumItemLabels": [
              "Everything",
              "Files",
              "Folders",
              "Text",
              "Symbols",
              "Commands"
            ]
          },
          "searchPlusPlus.rememberLastMode": {
            "order": 3,
            "type": "boolean",
            "default": false,
            "description": "Reopen the last-used tab when it is visible. Otherwise use Default Mode. Direct search commands open their requested tab."
          },
          "searchPlusPlus.shortcutPreset": {
            "order": 4,
            "type": "string",
            "enum": [
              "none",
              "vscode",
              "intellij"
            ],
            "enumDescriptions": [
              "Keep your existing shortcuts. Assign individual shortcuts in the Keyboard Shortcuts editor.",
              "Use the usual VS Code file, workspace symbol, text, and command search shortcuts for search++. F1 still opens the native Command Palette.",
              "Use IntelliJ-style file, workspace symbol, text, and action search shortcuts for search++. Keymap extensions may require explicit user overrides."
            ],
            "default": "none",
            "description": "Optional shortcuts for opening search modes directly. User keybindings take precedence.",
            "enumItemLabels": [
              "Keep existing shortcuts",
              "VS Code",
              "IntelliJ"
            ]
          },
          "searchPlusPlus.visibleTabs": {
            "order": 99,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "everywhere",
                "file",
                "folder",
                "text",
                "symbol",
                "command"
              ]
            },
            "uniqueItems": true,
            "minItems": 1,
            "default": [
              "everywhere",
              "file",
              "folder",
              "text",
              "symbol",
              "command"
            ],
            "description": "Tabs shown in the popup. Keep at least one tab visible. Direct search commands can still open hidden tabs.",
            "markdownDeprecationMessage": "Use `#searchPlusPlus.tabs#` to arrange and show or hide tabs in one list. Existing values still apply until Tabs is configured at this scope."
          },
          "searchPlusPlus.tabOrder": {
            "order": 100,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "everywhere",
                "file",
                "folder",
                "text",
                "symbol",
                "usages",
                "command"
              ],
              "enumDescriptions": [
                "Grouped search across Everything sections.",
                "File names and paths.",
                "Workspace folders.",
                "Text content.",
                "Symbols and their usages.",
                "Legacy alias for Symbols; there is no separate Usages tab.",
                "VS Code commands."
              ]
            },
            "uniqueItems": true,
            "default": [
              "everywhere",
              "file",
              "folder",
              "text",
              "symbol",
              "command"
            ],
            "description": "Order of search tabs and Tab navigation. Missing modes are appended; legacy usages entries map to Symbols.",
            "markdownDeprecationMessage": "Use `#searchPlusPlus.tabs#` to arrange and show or hide tabs in one list. Existing values still apply until Tabs is configured at this scope."
          }
        }
      },
      {
        "title": "Search results",
        "order": 2,
        "properties": {
          "searchPlusPlus.everything.sources": {
            "order": 1,
            "type": "object",
            "properties": {
              "Files": {
                "type": "boolean",
                "default": true
              },
              "Folders": {
                "type": "boolean",
                "default": true
              },
              "Symbols": {
                "type": "boolean",
                "default": true
              },
              "Text": {
                "type": "boolean",
                "default": true
              },
              "Commands": {
                "type": "boolean",
                "default": true
              }
            },
            "additionalProperties": false,
            "default": {
              "Files": true,
              "Folders": true,
              "Symbols": true,
              "Text": true,
              "Commands": true
            },
            "description": "Choose which sources appear on the Everything tab. Tick a source to include it; untick it to hide it."
          },
          "searchPlusPlus.everything.order": {
            "order": 2,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Files",
                "Folders",
                "Symbols",
                "Text",
                "Commands"
              ]
            },
            "uniqueItems": true,
            "default": [
              "Files",
              "Folders",
              "Symbols",
              "Text",
              "Commands"
            ],
            "markdownDescription": "Optional order of groups on the Everything tab. **Drag rows to reorder.** Use `#searchPlusPlus.everything.sources#` to show or hide sources. Missing sources appear last."
          },
          "searchPlusPlus.maxResults": {
            "order": 3,
            "type": "number",
            "default": 200,
            "description": "Maximum number of results to display per search mode"
          },
          "searchPlusPlus.everywhere.resultLimit": {
            "order": 4,
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "maximum": 200,
            "description": "Maximum results shown per section on the Everything tab"
          },
          "searchPlusPlus.debounceMs": {
            "order": 5,
            "type": "number",
            "default": 300,
            "description": "Debounce delay in milliseconds before triggering search"
          },
          "searchPlusPlus.excludeGitIgnored": {
            "order": 6,
            "type": "boolean",
            "default": true,
            "description": "Exclude git-ignored files and folders from search results by default"
          },
          "searchPlusPlus.excludeSearchIgnored": {
            "order": 7,
            "type": "boolean",
            "default": true,
            "description": "Exclude files matching .searchignore patterns from search results by default"
          },
          "searchPlusPlus.excludePaths": {
            "order": 8,
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Glob patterns to always exclude from search results (e.g., \"**/dist/**\", \"**/*.min.js\"). Applied in addition to gitignore."
          },
          "searchPlusPlus.everywhere.sections": {
            "order": 99,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "files",
                "folders",
                "symbols",
                "text",
                "commands"
              ]
            },
            "uniqueItems": true,
            "default": [
              "files",
              "folders",
              "symbols",
              "text",
              "commands"
            ],
            "markdownDescription": "Sections shown on the Everything tab. Array order controls display order. Remove a section to hide it.",
            "markdownDeprecationMessage": "Use `#searchPlusPlus.everything.sources#` for checkboxes and `#searchPlusPlus.everything.order#` for ordering. Existing choices remain effective until the replacements are configured at the same scope."
          }
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "searchPlusPlus.findUsages",
          "when": "editorTextFocus",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test": "vitest run",
    "test:host": "npm run build && node scripts/test-extension-host.mjs",
    "package": "vsce package --no-dependencies --githubBranch master --skip-license --out search-plus-plus.vsix",
    "check:release": "node scripts/check-release.mjs",
    "build:site": "node scripts/build-site.mjs",
    "publish:marketplace": "vsce publish --packagePath search-plus-plus.vsix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.4.0",
    "vitest": "^3.1.1"
  },
  "lint-staged": {
    "*.ts": "eslint"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.15.9",
    "fzf": "^0.5.2",
    "ignore": "^5.3.0"
  }
}
